# Copy to .env and fill in. See README.md for details.

# Required
BUTTERFLYMX_API_TOKEN=
API_KEY=
HOME_LAT=40.000000
HOME_LON=-74.000000
# id[:name[:relock_s[:hold_s]]], comma-separated, in unlock order
DOORS="1001:Front Door:9:90,1002:2nd Gate:17"

# Optional (defaults shown)
# GEOFENCE_RADIUS_M=200
# COOLDOWN_MINUTES=10
# GATE_DELAY_SECONDS=30
# UNLOCK_DURATION_SECONDS=30
# ACCURACY_GATE_M=100
# TRIGGER_RADIUS_M=100

# Auto-tuner. Without HA_TOKEN it only recommends changes.
# HA_URL=http://localhost:8123
# HA_TOKEN=
# TUNE_INTERVAL_HOURS=6
# TUNE_WINDOW_DAYS=14

# Runtime data paths
# ARRIVAL_LOG_PATH=arrivals.csv
# EVENT_LOG_PATH=events.csv
# TUNER_STATE_PATH=tuner_state.json
# TUNING_LOG_PATH=tuning.log
